    given-names: "Alireza"
version: 0.1.0
date-released: 2026-11-15
license: MIT
repository-code: "https://github.com/AlirezaMahdavishirkharkolaei/Legal-to-Code"
keywords:
  - rules as code
  - computational law
  - international taxation
  - OECD Model Tax Convention
  - WTO dispute settlement
  - legal technology
